# =============================================================================
# Dawei SaaS 开发环境 — 环境变量配置示例
# =============================================================================
# 用法: cp .env.saas.dev.example .env.saas.dev && 编辑填入真实值
#
# 适用场景: 多租户 SaaS 本地/测试环境开发, 弱校验 + DEBUG 日志,
#          工作区可降级到本地存储, MicroVM 可降级到 subprocess。
#
# 关键差异 (vs saas.prod):
#   - ENVIRONMENT=development → JWT/secret 弱校验, 缺值仅警告
#   - LOG_LEVEL=DEBUG → 详细日志便于调试
#   - WORKSPACE_STORE_BACKEND=local → 无需起 RustFS
#   - DAWEI_SANDBOX_PROVIDER=auto → 自动检测 (可降级 subprocess)
#   - AGENT_AUTO_APPROVE_TOOLS=true → 工具自动批准
#   - ANALYTICS_ENABLED=false → 不上报数据
#   - 本地 PostgreSQL / Redis (localhost)
#
# 生产部署请使用 .env.saas.prod.example
# =============================================================================


# =============================================================================
# 一、部署模式标识
# =============================================================================

# 运行模式: saas (多租户云端; 即使本地开发也保留 saas 标签, 走 SaaSGateway 路径)
# DAWEI_DEPLOYMENT_MODE=local|saas 仅为兼容保留 (未设 RUNTIME_MODE 时使用, 勿同时设)
DAWEI_RUNTIME_MODE=saas

# 环境: development (弱校验, JWT/secret 缺失仅警告)
ENVIRONMENT=development


# =============================================================================
# 二、基础配置
# =============================================================================

# Dawei 主目录 (开发用家目录下)
DAWEI_HOME=~/.dawei

# Agent 主目录源代码根路径 (供 MicroVM 内 agent 工具加载)
# 通常自动检测, 不需设置
# DAWEI_AGENT_SRC_DIR=


# =============================================================================
# 三、日志配置 (LOG_ 前缀) — 开发调试友好
# =============================================================================

LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=DEBUG
LOG_LOG_DIR=

# 日志文件大小 (开发用小一些, 方便查看)
LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=5

# LLM API HTTP 日志 (开发开, 方便看 token 用量)
LOG_ENABLE_LLM_API_HTTP_LOGGING=true

# 性能日志
LOG_ENABLE_PERFORMANCE_LOGGING=true

# 遥测 (开发关)
LOG_ENABLE_TELEMETRY=false

# 结构化日志 (开发用人类可读格式, 不开 JSON)
LOG_STRUCTURED_LOGGING=false

# 敏感数据脱敏 (开发也建议开, 防止误提交 .env)
LOG_SANITIZE_SENSITIVE_DATA=true

AGENT_LOG_LEVEL=DEBUG


# =============================================================================
# 四、安全配置 (开发弱校验)
# =============================================================================

# JWT 签名密钥 (开发可用弱值, production 模式会强制 32+ 字节)
# 注: ENVIRONMENT=development 时允许短密钥, 仅警告
JWT_SECRET=dev-secret-please-change-in-production-min-32-chars

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据加密密钥 (开发可空, 生产必须)
# ENCRYPTION_KEY=

# License 签名密钥 (开发可空)
# LICENSE_SECRET=

# PII 日志脱敏 salt (开发可不设, 用弱默认 + 警告)
# 生产必须 32+ 字符随机字符串 (KMS 管理)
# DAWEI_LOG_SALT=


# =============================================================================
# 五、数据库配置 (DB_ 前缀) — 本地 PostgreSQL
# =============================================================================

# 开发用本地 PostgreSQL, 也可降级 SQLite
DB_URL=postgresql://dawei:dawei@localhost:5432/dawei_dev

# 数据库路径 (仅 SQLite)
DB_PATH=~/.dawei/data/dawei.db

# SQL 调试日志 (开发开)
DB_ECHO=true

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# =============================================================================
# 六、Redis 配置 (REDIS_ 前缀) — 本地
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10


# =============================================================================
# 七、LLM 配置 (LLM_ 前缀)
# =============================================================================

# 默认模型
LLM_DEFAULT_MODEL=deepseek-chat

# DeepSeek 配置 (开发可用自己的 key)
DEEPSEEK_API_KEY=sk-CHANGE_ME_DEV
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (本地离线)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# Embedding
LLM_EMBEDDING_BASE_URL=http://localhost:11434
LLM_EMBEDDING_API_KEY=ollama
LLM_EMBEDDING_MODEL=qwen3-embedding:8b

LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0


# =============================================================================
# 八、Agent 配置 (AGENT_ 前缀)
# =============================================================================

AGENT_MODE=orchestrator
AGENT_ENABLE_AUTO_MODE_SWITCH=false

AGENT_ENABLE_SKILLS=true
AGENT_ENABLE_MCP=true

# 自动批准工具 (开发默认 true, 生产强制 false)
AGENT_AUTO_APPROVE_TOOLS=true

# 并发数 (开发保守)
AGENT_MAX_CONCURRENT_SUBTASKS=5


# =============================================================================
# 九、Agent 重试 / 检查点 / 超时
# =============================================================================

AGENT_RETRY_MAX_RETRIES=3
AGENT_RETRY_RETRY_DELAY=1.0
AGENT_RETRY_RETRY_BACKOFF_FACTOR=2.0
AGENT_RETRY_MAX_DELAY=60.0

AGENT_CHECKPOINT_CHECKPOINT_INTERVAL=300
AGENT_CHECKPOINT_MAX_CHECKPOINTS=10
AGENT_CHECKPOINT_ENABLE_COMPRESSION=true

AGENT_TIMEOUT_TOOL_EXECUTION_TIMEOUT=60
AGENT_TIMEOUT_REQUEST_TIMEOUT=180


# =============================================================================
# 十、熔断器 / 限流器 / 请求队列 (低并发配置)
# =============================================================================

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60.0
CIRCUIT_BREAKER_MAX_RETRIES=5

RATE_LIMITER_INITIAL_RATE=10.0
RATE_LIMITER_MIN_RATE=0.5
RATE_LIMITER_MAX_RATE=100.0
RATE_LIMITER_BURST_CAPACITY=50

REQUEST_QUEUE_MAX_CONCURRENT=10
REQUEST_QUEUE_MAX_QUEUE_SIZE=1000
REQUEST_QUEUE_DEFAULT_TIMEOUT=300.0


# =============================================================================
# 十一、外部服务 API 地址 (本地开发指向 localhost)
# =============================================================================

UNISEARCHER_API_URL=http://localhost:8014/api/v1/legal
SANCTIONS_API_URL=http://localhost:8012
SUPPORT_API_URL=http://localhost:8011/support/api
NORFLOW_API_URL=http://localhost:8013/api/v1
MARKET_API_URL=http://localhost:8011/support/api


# =============================================================================
# 十二、记忆 / 知识 / 技能 / 工具系统
# =============================================================================

MEMORY_ENABLED=false
MEMORY_DB_PATH=~/.dawei/memory.db
MEMORY_VIRTUAL_PAGE_SIZE=2000
MEMORY_MAX_ACTIVE_PAGES=5

SKILLS_ENABLED=true
SKILLS_AUTO_DISCOVERY=true

TOOL_BUILTIN_TOOLS_ENABLED=true
TOOL_SYSTEM_TOOLS_ENABLED=true
TOOL_USER_TOOLS_ENABLED=true
TOOL_WORKSPACE_TOOLS_ENABLED=true
TOOL_DEFAULT_TIMEOUT=60
TOOL_MAX_CONCURRENT_EXECUTIONS=5


# =============================================================================
# 十三、分析 / 存储 / 邮件
# =============================================================================

# 分析 (开发关闭)
ANALYTICS_ENABLED=false
ANALYTICS_SENTRY_DSN=
ANALYTICS_GA_TRACKING_ID=
ANALYTICS_MIXPANEL_TOKEN=
ANALYTICS_RETENTION_DAYS=30

# 存储 (通用文件)
STORAGE_STORAGE_TYPE=local_filesystem
STORAGE_ROOT_DIR=~/.dawei/files
STORAGE_CREATE_IF_MISSING=true

# SMTP (开发不配置)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=


# =============================================================================
# 十四、SaaS 沙箱配置 (开发: saas 模式禁止降级, 见下)
# =============================================================================

# ----- 14.1 Provider 总开关 -----

# 开发推荐: auto (自动检测; 注意 saas 模式下无 MicroVM 时不会降级而是
# fail-fast 报错 —— 2026-09-13 起 docker/subprocess 被 SandboxSecurityError 拦截。
# 本地无 CubeSandbox 的开发请改用 .env.example, 即 DAWEI_DEPLOYMENT_MODE=local)
# 生产强制: saas
DAWEI_SANDBOX_PROVIDER=auto

# 等同于 DAWEI_SANDBOX_PROVIDER=saas, 任一设置即可
# DAWEI_SANDBOX_GATEWAY_ENABLED=true

# ----- 14.2 Backend 选择 -----

# 全局默认 backend (有 MicroVM 时使用)
DAWEI_SANDBOX_BACKEND=cubesandbox

# 租户级绑定 (开发可空)
# DAWEI_SANDBOX_BACKEND_BY_TENANT=

# ----- 14.3 CubeSandbox 后端 (本地测试可指向 docker-compose) -----
# 注意: e2b SDK 不读 DAWEI_SANDBOX_API_URL —— SDK 只认 E2B_API_URL/E2B_DOMAIN
# 环境变量 (provider 不代传), 启用 cube 后端时下面两组都要取消注释

# DAWEI_SANDBOX_API_URL=http://localhost:3000
# DAWEI_SANDBOX_API_KEY=e2b_0000000000000000000000000000000000000000
# E2B_API_URL=http://localhost:3000
# E2B_DOMAIN=cube.app
# 模板 ID 每次重建都会变, 取真实值: cubemastercli tpl list (占位值 → 130404)
# DAWEI_SANDBOX_TEMPLATE=tpl-xxxx

# ----- 14.4 AgentENV 后端 -----

# DAWEI_SANDBOX_API_URL=http://localhost:8000
# DAWEI_SANDBOX_TEMPLATE=code-interpreter
# E2B_API_KEY=e2b_0000000000000000000000000000000000000000

# ----- 14.5 通用沙箱行为 -----

DAWEI_WORKSPACE_ROOT_ALLOWLIST=/tmp:/home:/workspace:/srv:/data

# 开发懒加载 (避免不必要的资源占用)
DAWEI_SANDBOX_PREWARM_ON_SESSION_START=0

# 工具执行模式 (有 sandbox 时用 sandbox, 否则 host)
DAWEI_TOOL_EXECUTION_MODE=host


# =============================================================================
# 十五、WorkspaceStore 配置 (开发: 本地后端)
# =============================================================================

# 开发用本地后端, 无需起 RustFS
WORKSPACE_STORE_BACKEND=local

# 本地后端根目录
WORKSPACE_STORE_LOCAL_ROOT=~/.dawei/workspace-store

# 开发可不加密 (本地磁盘已有 FS 级加密)
# WORKSPACE_STORE_ENCRYPTION_KEY=

# 如需测试 S3 路径, 改下面这些, 注释掉上面 local:
# WORKSPACE_STORE_BACKEND=rustfs
# WORKSPACE_STORE_ENDPOINT=http://localhost:9000
# WORKSPACE_STORE_BUCKET=nn-bot-workspaces-dev
# WORKSPACE_STORE_ACCESS_KEY=rustfsadmin
# WORKSPACE_STORE_SECRET_KEY=rustfsadmin
# WORKSPACE_STORE_REGION=us-east-1


# =============================================================================
# 十六、网络策略 (开发不启用 eBPF)
# =============================================================================

# eBPF 仅生产用, 开发单用户无需
# DAWEI_SANDBOX_NETWORK_POLICY=


# =============================================================================
# 十七、Admin / Internal Token (开发弱)
# =============================================================================

SANDBOX_ADMIN_TOKEN=dev-admin-token

DAWEI_INTERNAL_TOKEN=dev-internal-token


# =============================================================================
# 十八、TUI / 运行时控制
# =============================================================================

DAWEI_TUI_MODE=false

# 超级模式 (开发可开, 用于调试边界场景)
# ⚠️ 严禁在生产开启
DAWEI_SUPER_MODE=0

TEXTUAL_FULLSCREEN=1


# =============================================================================
# 十九、LiteLLM 兼容 (开发可选)
# =============================================================================

LITELLM_API_KEY=