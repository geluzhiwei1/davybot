# =============================================================================
# Dawei Server 开发环境 — 环境变量配置示例
# =============================================================================
# 用法: cp .env.server.dev.example .env.server.dev && 编辑填入真实值
#
# 适用场景: `dawei server start` / server 二进制 — 本地无界面运行,
#          web 前端 (浏览器) 连 localhost。无沙箱 (多模式统一方案 §3)。
#
# 关键差异 (vs desktop):
#   - DAWEI_RUNTIME_MODE=server (无 sandbox capability → 前端沙箱区块隐藏)
#   - 不配置 DAWEI_SANDBOX_PROVIDER (server 模式无沙箱)
#   - WORKSPACE_STORE_BACKEND=local
#
# 生产部署请使用 .env.server.prod.example
# =============================================================================


# =============================================================================
# 一、运行模式标识
# =============================================================================

# 运行模式: server (本地无界面; web 构建连 localhost)
DAWEI_RUNTIME_MODE=server

# 环境: development (弱校验, secret 缺失仅警告)
ENVIRONMENT=development


# =============================================================================
# 二、基础配置
# =============================================================================

DAWEI_HOME=~/.dawei


# =============================================================================
# 三、日志配置 — DEBUG 级别
# =============================================================================

LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=DEBUG
LOG_STRUCTURED_LOGGING=false
LOG_ENABLE_TELEMETRY=false
LOG_SANITIZE_SENSITIVE_DATA=true


# =============================================================================
# 四、安全配置 (开发弱校验)
# =============================================================================

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440


# =============================================================================
# 五、数据库配置 — 本地 SQLite
# =============================================================================

DB_URL=sqlite:///~/.dawei/data/dawei.db
DB_PATH=~/.dawei/data/dawei.db
DB_ECHO=false
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0


# =============================================================================
# 六、LLM 配置
# =============================================================================

LLM_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-CHANGE_ME_DEV
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT=300


# =============================================================================
# 七、Agent 配置 (保守值)
# =============================================================================

AGENT_MODE=orchestrator
AGENT_AUTO_APPROVE_TOOLS=false
AGENT_TIMEOUT_TOOL_EXECUTION_TIMEOUT=60


# =============================================================================
# 八、外部服务 API 地址 (本地开发指向 localhost)
# =============================================================================

UNISEARCHER_API_URL=http://localhost:8014/api/v1/legal
SANCTIONS_API_URL=http://localhost:8012

# server 自包含: 默认不连账号体系/市场 (无 auth/market capability, 免登录直达)。
# 需要接入市场时显式设 MARKET_API_URL (设了才注册 market capability)。
# SUPPORT_API_URL=http://localhost:8011/support/api
# MARKET_API_URL=http://localhost:8011/support/api


# =============================================================================
# 八点五、server 自包含访问密码 (可选)
# =============================================================================

# 设了 → 所有 API/WS 要求 Authorization: Bearer <password>; 不设 → 放行。
# server 模式 CLI 默认绑定 0.0.0.0 (局域网可访问), 公网/局域网部署建议设置。
# DAWEI_SERVER_PASSWORD=


# =============================================================================
# 九、分析 (开发关闭)
# =============================================================================

ANALYTICS_ENABLED=false


# =============================================================================
# 十、沙箱 — 显式不配置 (server 模式无沙箱)
# =============================================================================

# 勿设 DAWEI_SANDBOX_PROVIDER (多模式统一方案 §3: server/tui 无沙箱)
# DAWEI_SANDBOX_PROVIDER=


# =============================================================================
# 十一、WorkspaceStore 配置 — 本地后端
# =============================================================================

WORKSPACE_STORE_BACKEND=local
WORKSPACE_STORE_LOCAL_ROOT=~/.dawei/workspace-store
