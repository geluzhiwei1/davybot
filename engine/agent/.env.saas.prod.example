# =============================================================================
# Dawei SaaS 生产环境 — 环境变量配置示例
# =============================================================================
# 用法: cp .env.saas.prod.example .env.saas.prod && 编辑填入真实值
#       然后: ln -sf .env.saas.prod .env
#
# 适用场景: 多租户 SaaS 生产部署, 强校验 + INFO 日志,
#          S3 / RustFS 工作区存储, MicroVM 沙箱, eBPF 网络策略。
#
# 关键差异 (vs saas.dev):
#   - ENVIRONMENT=production → JWT/secret 强制 32+ 字节, 缺值即报错
#   - LOG_LEVEL=INFO → 关键日志 (避免敏感数据泄露)
#   - LOG_STRUCTURED_LOGGING=true → JSON 格式, 接入 ELK / Loki
#   - WORKSPACE_STORE_BACKEND=rustfs → S3-compatible 生产存储
#   - WORKSPACE_STORE_ENCRYPTION_KEY 必填 (AES-256 客户端加密)
#   - DAWEI_SANDBOX_PROVIDER=saas → SaaSGateway (cube + agentenv)
#   - AGENT_AUTO_APPROVE_TOOLS=false → 走管理员审核
#   - DAWEI_LOG_SALT 必填 (PII 合规)
#   - DAWEI_SANDBOX_NETWORK_POLICY=eBPF YAML (N4 网络隔离)
#   - ANALYTICS_ENABLED=true → Sentry / GA / Mixpanel
#
# 开发部署请使用 .env.saas.dev.example
# =============================================================================


# =============================================================================
# 一、部署模式标识
# =============================================================================

# 运行模式: saas (多租户云端)。DAWEI_DEPLOYMENT_MODE 仅为兼容保留, 勿同时设。
DAWEI_RUNTIME_MODE=saas

# 环境: production (强校验, 所有 secret 必填且 32+ 字节)
ENVIRONMENT=production


# =============================================================================
# 二、基础配置
# =============================================================================

# Dawei 主目录 (systemd 服务专用目录)
DAWEI_HOME=/var/lib/dawei

# Agent 主目录源代码根路径
DAWEI_AGENT_SRC_DIR=/opt/nn-bot/agent


# =============================================================================
# 三、日志配置 (LOG_ 前缀) — 生产 INFO 级别 + JSON 结构化
# =============================================================================

LOG_LEVEL=INFO
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_LEVEL=INFO

# 日志目录
LOG_LOG_DIR=/var/log/dawei

# 日志文件大小 (生产大一些, 减少轮转频率)
LOG_MAX_FILE_SIZE=50
LOG_BACKUP_COUNT=10

# LLM API HTTP 日志 (生产关闭, 避免 token 泄露)
LOG_ENABLE_LLM_API_HTTP_LOGGING=false

# 性能日志
LOG_ENABLE_PERFORMANCE_LOGGING=true

# 遥测
LOG_ENABLE_TELEMETRY=true

# 结构化日志 (JSON, 接入 ELK / Loki)
LOG_STRUCTURED_LOGGING=true

# 敏感数据脱敏 (强制开启)
LOG_SANITIZE_SENSITIVE_DATA=true

AGENT_LOG_LEVEL=INFO


# =============================================================================
# 四、安全配置 (生产强校验, 缺值即报错)
# =============================================================================

# JWT 签名密钥 (强制 32+ 字节随机字符串)
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
# 重要: 与 NN_BOT_ADMIN_JWT_SECRET 完全一致
JWT_SECRET=CHANGE_ME_PRODUCTION_32_BYTES_HEX

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# 数据加密密钥 (32 字节)
ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_32_BYTES_HEX

# License 签名密钥
LICENSE_SECRET=CHANGE_ME_PRODUCTION_RANDOM

# PII 日志脱敏 salt (N6 合规要求, 强制)
# 32+ 字符随机字符串, 存储在 KMS / secrets manager
# 轮换后历史日志的 hash 将失效 (符合 GDPR / 等保要求)
DAWEI_LOG_SALT=CHANGE_ME_PRODUCTION_RANDOM_SALT_32_CHARS


# =============================================================================
# 五、数据库配置 (DB_ 前缀) — 远程 PostgreSQL
# =============================================================================

# 生产 PostgreSQL, 推荐主从 + 连接池
DB_URL=postgresql://dawei:STRONG_PASSWORD@db.internal:5432/dawei

DB_PATH=/var/lib/dawei/data/dawei.db

# SQL 调试日志 (生产关闭)
DB_ECHO=false

# 连接池
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10


# =============================================================================
# 六、Redis 配置 (REDIS_ 前缀) — 远程集群
# =============================================================================

REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50


# =============================================================================
# 七、LLM 配置 (LLM_ 前缀)
# =============================================================================

LLM_DEFAULT_MODEL=deepseek-chat

# DeepSeek 配置 (生产主力)
DEEPSEEK_API_KEY=sk-CHANGE_ME_PROD
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (内网部署)
OLLAMA_BASE_URL=http://ollama.internal:11434
OLLAMA_API_KEY=ollama

# Embedding
LLM_EMBEDDING_BASE_URL=http://ollama.internal:11434
LLM_EMBEDDING_API_KEY=ollama
LLM_EMBEDDING_MODEL=qwen3-embedding:8b

LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0


# =============================================================================
# 八、Agent 配置 (AGENT_ 前缀)
# =============================================================================

AGENT_MODE=orchestrator
AGENT_ENABLE_AUTO_MODE_SWITCH=false

AGENT_ENABLE_SKILLS=true
AGENT_ENABLE_MCP=true

# 自动批准工具 (生产强制 false, 走管理员审核)
AGENT_AUTO_APPROVE_TOOLS=false

# 并发数 (生产可调高)
AGENT_MAX_CONCURRENT_SUBTASKS=10


# =============================================================================
# 九、Agent 重试 / 检查点 / 超时
# =============================================================================

AGENT_RETRY_MAX_RETRIES=3
AGENT_RETRY_RETRY_DELAY=1.0
AGENT_RETRY_RETRY_BACKOFF_FACTOR=2.0
AGENT_RETRY_MAX_DELAY=60.0

AGENT_CHECKPOINT_CHECKPOINT_INTERVAL=300
AGENT_CHECKPOINT_MAX_CHECKPOINTS=10
AGENT_CHECKPOINT_ENABLE_COMPRESSION=true

# 工具超时 (生产可放宽)
AGENT_TIMEOUT_TOOL_EXECUTION_TIMEOUT=120
AGENT_TIMEOUT_REQUEST_TIMEOUT=180


# =============================================================================
# 十、熔断器 / 限流器 / 请求队列 (高并发)
# =============================================================================

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60.0
CIRCUIT_BREAKER_MAX_RETRIES=5

RATE_LIMITER_INITIAL_RATE=10.0
RATE_LIMITER_MIN_RATE=0.5
RATE_LIMITER_MAX_RATE=100.0
RATE_LIMITER_BURST_CAPACITY=50

REQUEST_QUEUE_MAX_CONCURRENT=20
REQUEST_QUEUE_MAX_QUEUE_SIZE=2000
REQUEST_QUEUE_DEFAULT_TIMEOUT=300.0


# =============================================================================
# 十一、外部服务 API 地址 (生产域名)
# =============================================================================

UNISEARCHER_API_URL=https://<deployment-host>/kb-searcher/api/v1/legal
# SANCTIONS_API_URL=https://<deployment-host>/sanctions
SUPPORT_API_URL=https://<deployment-host>/support/api
NORFLOW_API_URL=https://<deployment-host>/normflow/api/v1
MARKET_API_URL=https://<deployment-host>/support/api


# =============================================================================
# 十二、记忆 / 知识 / 技能 / 工具
# =============================================================================

MEMORY_ENABLED=true
MEMORY_DB_PATH=/var/lib/dawei/memory.db
MEMORY_VIRTUAL_PAGE_SIZE=2000
MEMORY_MAX_ACTIVE_PAGES=5

SKILLS_ENABLED=true
SKILLS_AUTO_DISCOVERY=true

TOOL_BUILTIN_TOOLS_ENABLED=true
TOOL_SYSTEM_TOOLS_ENABLED=true
TOOL_USER_TOOLS_ENABLED=true
TOOL_WORKSPACE_TOOLS_ENABLED=true
TOOL_DEFAULT_TIMEOUT=120
TOOL_MAX_CONCURRENT_EXECUTIONS=10


# =============================================================================
# 十三、分析 / 存储 / 邮件
# =============================================================================

# 分析 (生产全开)
ANALYTICS_ENABLED=true
ANALYTICS_SENTRY_DSN=https://KEY@sentry.io/PROJECT
ANALYTICS_GA_TRACKING_ID=G-XXXXXXX
ANALYTICS_MIXPANEL_TOKEN=mp_change_me
ANALYTICS_RETENTION_DAYS=90

# 存储 (S3)
STORAGE_STORAGE_TYPE=s3
STORAGE_ROOT_DIR=s3://dawei-files
STORAGE_CREATE_IF_MISSING=true

# SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.CHANGE_ME
EMAIL_FROM=noreply@<deployment-host>
EMAIL_TO=ops@<deployment-host>


# =============================================================================
# 十四、SaaS 沙箱配置 (生产: 强制 SaaSGateway + MicroVM)
# =============================================================================
# 运维警示:
#   1. 依赖 extras 必须预装: uv pip install -e ".[sandbox,workspace-store]"
#      (e2b/boto3 均不在 base deps; 缺失是懒 fail-fast, 首次用沙箱/工作区才报错)
#   2. provider AUTO 解析优先级: 用户安全配置(security.json sandboxProvider)
#      > DAWEI_SANDBOX_PROVIDER > 自动探测。部署前确认 DAWEI_HOME 下
#      security.json 未残留旧 sandboxProvider, 否则会劫持本文件配置

# ----- 14.1 Provider 总开关 -----

# 强制 SaaSGateway (走 cube + agentenv 路由)
DAWEI_SANDBOX_PROVIDER=saas

# ----- 14.2 Backend 选择 -----

# 全局默认 backend
DAWEI_SANDBOX_BACKEND=cubesandbox

# 租户级绑定 (JSON, 优先级高于全局默认)
# 例: {"enterprise":"agentenv","vip":"cubesandbox"}
DAWEI_SANDBOX_BACKEND_BY_TENANT={"enterprise":"agentenv"}

# ----- 14.3 CubeSandbox 后端 (生产) -----
# 集群: sandbox.davybot.com (box1), 规格: project/prod/sandbox.davybot.com/box1.md
#
# !! E2B SDK 不读 DAWEI_SANDBOX_API_URL —— CubeSandboxProvider 不向 SDK 传
# !! api_url/domain, SDK 只认进程环境变量 E2B_API_URL/E2B_DOMAIN。五元组两侧
# !! 都必须配, 否则 health_check 通过 (dawei 探测 DAWEI_SANDBOX_API_URL) 但
# !! E2BSandbox.create() 打到 e2b SDK 默认云端端点 → 401/超时, 极难排查。

# e2b SDK 侧 (e2b/connection_config.py 实际读取)
E2B_API_URL=http://10.168.1.105:8046   # box1 CubeAPI; VPN 可用 http://100.64.0.2:8046
E2B_API_KEY=e2b_000000                 # CubeSandbox 单机内置 key
E2B_DOMAIN=cube.app                    # 必须与 CUBE_API_SANDBOX_DOMAIN 一致 (box1 默认 cube.app)

# dawei 侧 (健康检查 / provider auto-detect)
DAWEI_SANDBOX_API_URL=http://10.168.1.105:8046
# provider 读取顺序: E2B_API_KEY > DAWEI_SANDBOX_API_KEY, 保持一致即可
DAWEI_SANDBOX_API_KEY=e2b_000000

# 模板 ID: tpl create-from-image 每次生成新 tpl-id, 必须回填真实值!
#   sudo cubemastercli tpl list        # 在 box1 上取 tpl-xxxx
# 占位值必触发 CubeMaster 130404: template not found (test_execute_command 复现过)
DAWEI_SANDBOX_TEMPLATE=tpl-REPLACE_ME_VIA_cubemastercli_tpl_list

# ----- 14.4 AgentENV 后端 (生产) -----

# (当某租户路由到 agentenv 时启用)
# DAWEI_SANDBOX_API_URL=https://agentenv.internal:8000
# DAWEI_SANDBOX_TEMPLATE=code-interpreter
# E2B_API_KEY=ae_CHANGE_ME_PROD

# ----- 14.5 通用沙箱行为 -----

# workspace 白名单
DAWEI_WORKSPACE_ROOT_ALLOWLIST=/workspace:/home:/srv/workspaces:/tmp:/var/tmp

# 预热 (生产开启, 减少首次延迟)
DAWEI_SANDBOX_PREWARM_ON_SESSION_START=1

# 工具执行模式: 强制 sandbox
DAWEI_TOOL_EXECUTION_MODE=sandbox


# =============================================================================
# 十五、WorkspaceStore 配置 (生产: S3/RustFS + AES-256 加密)
# =============================================================================

# S3-compatible 后端 (自托管 RustFS, 与 box1 同机)
# 规格: project/prod/fs.davybot.com/rustfs1.md (API :8038, 控制台 :8039)
WORKSPACE_STORE_BACKEND=rustfs

# S3 endpoint (fs1/box1 同机 10.168.1.105; VPN 可用 http://100.64.0.2:8038)
WORKSPACE_STORE_ENDPOINT=http://10.168.1.105:8038

# bucket (首次使用自动创建, 也可在 rustfs 上预建)
WORKSPACE_STORE_BUCKET=nn-bot-workspaces

# 凭证: 真实值在 project/prod/fs1.davybot.com/.env 的
# RUSTFS_ACCESS_KEY / RUSTFS_SECRET_KEY (IAM 最小权限: 只允许此 bucket)
WORKSPACE_STORE_ACCESS_KEY=CHANGE_ME_RUSTFS_ACCESS_KEY
WORKSPACE_STORE_SECRET_KEY=CHANGE_ME_RUSTFS_SECRET_KEY

# 区域
WORKSPACE_STORE_REGION=us-east-1

# 客户端加密密钥 (AES-256, 32 字节 hex)
# 生成: python -c "import secrets; print(secrets.token_hex(32))"
# 重要: 加密 .dawei/chat-history/、checkpoints/、settings.json 等敏感子树
WORKSPACE_STORE_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# 本地后端根目录 (仅当 WORKSPACE_STORE_BACKEND=local, 生产不用)
# WORKSPACE_STORE_LOCAL_ROOT=/var/lib/dawei/workspace-store


# =============================================================================
# 十六、eBPF 网络策略 (生产: 必填, N4 网络隔离)
# =============================================================================

# 策略 YAML 文件路径 (强制配置, 不存在降级到 deny-all 但生产必填)
# 文件格式: see dawei/sandbox/dawei_sandbox_network_policy.yaml
DAWEI_SANDBOX_NETWORK_POLICY=/etc/dawei/sandbox_network_policy.yaml


# =============================================================================
# 十七、Admin / Internal Token (生产强)
# =============================================================================

# 沙箱 Admin Token (与 NN_BOT_ADMIN_JWT_SECRET 完全一致)
SANDBOX_ADMIN_TOKEN=CHANGE_ME_32_BYTES_HEX

# Internal Stream Token
DAWEI_INTERNAL_TOKEN=CHANGE_ME_RANDOM


# =============================================================================
# 十八、TUI / 运行时控制
# =============================================================================

DAWEI_TUI_MODE=false

# 超级模式 (生产严禁开启, 会绕过所有安全检查)
DAWEI_SUPER_MODE=0

TEXTUAL_FULLSCREEN=1


# =============================================================================
# 十九、LiteLLM 兼容 (生产可选)
# =============================================================================

LITELLM_API_KEY=