# =============================================================================
# Dawei Desktop 生产环境 (打包发行版) — 环境变量配置示例
# =============================================================================
# 用法: 打包脚本 / 应用首次启动时, 拷贝此模板到用户家目录作为 .env 初始化
#       用户首次启动后可在 ~/.dawei/.env 中调整
#
# 适用场景: 桌面应用打包发行 (Tauri / Electron / PyInstaller),
#          单用户本地, 但需平衡:
#          - 用户体验 (低日志噪音, 简单配置)
#          - 安全性 (强校验 secret, 默认开脱敏)
#          - 遥测 (用户首次启动时询问, 后续尊重用户选择)
#
# 关键差异 (vs desktop.dev):
#   - ENVIRONMENT=production → 强校验 (但允许用户用空白值重新走弱校验)
#   - LOG_LEVEL=WARNING → 桌面用户不要 DEBUG 噪音
#   - LOG_ENABLE_TELEMETRY=true → 允许用户后续在设置里关
#   - ANALYTICS_ENABLED=true → 同上
#   - JWT_SECRET 自动生成 (32 字节随机, 写入 ~/.dawei/.jwt-secret, 永不变)
#   - MEMORY_ENABLED=true → 默认开
#   - DAWEI_SUPER_MODE=0 (永远, 不允许用户改)
#
# 开发 (从源码运行) 请使用 .env.desktop.dev.example
# =============================================================================


# =============================================================================
# 一、部署模式标识
# =============================================================================

# 运行模式: desktop (单用户本地; Tauri sidecar 启动时 CLI 也会注入此默认值)
DAWEI_RUNTIME_MODE=desktop

# 环境: production (但桌面应用允许用户首次启动时弱校验, 后续强制)
ENVIRONMENT=production


# =============================================================================
# 二、基础配置
# =============================================================================

# Dawei 主目录 (桌面应用固定为用户家目录)
# Windows: %APPDATA%/dawei
# macOS:   ~/Library/Application Support/dawei
# Linux:   ~/.dawei
DAWEI_HOME=~/.dawei

# Agent 主目录源代码根路径 (打包后通常不需要, Tauri 内嵌资源)
# DAWEI_AGENT_SRC_DIR=


# =============================================================================
# 三、日志配置 (LOG_ 前缀) — 桌面用户友好 (WARNING 级别)
# =============================================================================

# 全局日志: WARNING (桌面用户不关心 DEBUG 噪音, 但保留 ERROR 排查能力)
LOG_LEVEL=WARNING

# 控制台: WARNING (CLI 启动时用户看到的是 ERROR, 避免刷屏)
LOG_CONSOLE_LEVEL=WARNING

# 文件: INFO (写入文件, 便于事后排查, 不打扰用户)
LOG_FILE_LEVEL=INFO

# 日志目录
LOG_LOG_DIR=

# 文件大小 (桌面用小一些, 减少磁盘占用)
LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=3

# LLM API HTTP 日志 (桌面关闭, 避免 token 写入本地日志)
LOG_ENABLE_LLM_API_HTTP_LOGGING=false

# 性能日志 (桌面关, 减少日志量)
LOG_ENABLE_PERFORMANCE_LOGGING=false

# 遥测 (允许用户后续在设置里关, 默认开, 首次启动 UI 询问)
LOG_ENABLE_TELEMETRY=true

# 结构化日志 (桌面关闭, 人类可读)
LOG_STRUCTURED_LOGGING=false

# 敏感数据脱敏 (强制开启)
LOG_SANITIZE_SENSITIVE_DATA=true

AGENT_LOG_LEVEL=WARNING


# =============================================================================
# 四、安全配置 (桌面: 自动生成 + 用户不可见)
# =============================================================================

# JWT 签名密钥 (桌面应用首次启动时自动生成, 写入 ~/.dawei/.jwt-secret)
# 用户不需要看到此值, 也无需修改
# 注: 桌面 JWT 仅用于 WebSocket 鉴权, 不跨网络传输
# JWT_SECRET=AUTO_GENERATED_ON_FIRST_LAUNCH

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据加密密钥 (同上, 自动生成, 写入 ~/.dawei/.encryption-key)
# ENCRYPTION_KEY=AUTO_GENERATED_ON_FIRST_LAUNCH

# License 签名密钥 (首次启动时从 license server 拉取, 写入 ~/.dawei/license.dat)
# LICENSE_SECRET=

# PII 日志脱敏 salt (桌面: 自动生成, 写入 ~/.dawei/.log-salt)
# DAWEI_LOG_SALT=AUTO_GENERATED_ON_FIRST_LAUNCH


# =============================================================================
# 五、数据库配置 (DB_ 前缀) — 本地 SQLite
# =============================================================================

DB_URL=sqlite:///~/.dawei/data/dawei.db
DB_PATH=~/.dawei/data/dawei.db

DB_ECHO=false
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0


# =============================================================================
# 六、Redis 配置 (REDIS_ 前缀) — 桌面生产通常不用
# =============================================================================

# Desktop 单进程不需要 Redis
# 仅高级用户启用跨进程 MCP 时才需要
# REDIS_HOST=localhost
# REDIS_PORT=8024
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_MAX_CONNECTIONS=10


# =============================================================================
# 七、LLM 配置 (LLM_ 前缀)
# =============================================================================

LLM_DEFAULT_MODEL=deepseek-chat

# DeepSeek
DEEPSEEK_API_KEY=USER_CONFIGURED_IN_SETTINGS
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (本地离线 LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# Embedding
LLM_EMBEDDING_BASE_URL=http://localhost:11434
LLM_EMBEDDING_API_KEY=ollama
LLM_EMBEDDING_MODEL=qwen3-embedding:8b

LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0


# =============================================================================
# 八、Agent 配置 (AGENT_ 前缀)
# =============================================================================

AGENT_MODE=orchestrator
AGENT_ENABLE_AUTO_MODE_SWITCH=false

AGENT_ENABLE_SKILLS=true
AGENT_ENABLE_MCP=true

# 自动批准工具 (桌面用户自负责, 永远 true)
AGENT_AUTO_APPROVE_TOOLS=true

AGENT_MAX_CONCURRENT_SUBTASKS=3


# =============================================================================
# 九、Agent 重试 / 检查点 / 超时
# =============================================================================

AGENT_RETRY_MAX_RETRIES=3
AGENT_RETRY_RETRY_DELAY=1.0
AGENT_RETRY_RETRY_BACKOFF_FACTOR=2.0
AGENT_RETRY_MAX_DELAY=60.0

AGENT_CHECKPOINT_CHECKPOINT_INTERVAL=300
AGENT_CHECKPOINT_MAX_CHECKPOINTS=10
AGENT_CHECKPOINT_ENABLE_COMPRESSION=true

AGENT_TIMEOUT_TOOL_EXECUTION_TIMEOUT=60
AGENT_TIMEOUT_REQUEST_TIMEOUT=180


# =============================================================================
# 十、熔断器 / 限流器 / 请求队列
# =============================================================================

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60.0
CIRCUIT_BREAKER_MAX_RETRIES=5

RATE_LIMITER_INITIAL_RATE=5.0
RATE_LIMITER_MIN_RATE=0.5
RATE_LIMITER_MAX_RATE=50.0
RATE_LIMITER_BURST_CAPACITY=20

REQUEST_QUEUE_MAX_CONCURRENT=5
REQUEST_QUEUE_MAX_QUEUE_SIZE=1000
REQUEST_QUEUE_DEFAULT_TIMEOUT=300.0


# =============================================================================
# 十一、外部服务 API 地址 (桌面生产: 用户在设置里配置, 默认 SaaS 域名)
# =============================================================================

UNISEARCHER_API_URL=https://<deployment-host>/kb-searcher/api/v1/legal
SANCTIONS_API_URL=https://<deployment-host>/sanctions
SUPPORT_API_URL=https://<deployment-host>/support/api
NORFLOW_API_URL=https://<deployment-host>/normflow/api/v1
MARKET_API_URL=https://<deployment-host>/support/api


# =============================================================================
# 十二、记忆 / 知识 / 技能 / 工具
# =============================================================================

# 记忆 (桌面生产默认开)
MEMORY_ENABLED=true
MEMORY_DB_PATH=~/.dawei/memory.db
MEMORY_VIRTUAL_PAGE_SIZE=2000
MEMORY_MAX_ACTIVE_PAGES=5

SKILLS_ENABLED=true
SKILLS_AUTO_DISCOVERY=true

TOOL_BUILTIN_TOOLS_ENABLED=true
TOOL_SYSTEM_TOOLS_ENABLED=true
TOOL_USER_TOOLS_ENABLED=true
TOOL_WORKSPACE_TOOLS_ENABLED=true
TOOL_DEFAULT_TIMEOUT=60
TOOL_MAX_CONCURRENT_EXECUTIONS=3


# =============================================================================
# 十三、分析 / 存储 / 邮件
# =============================================================================

# 分析 (桌面生产默认开, 但用户首次启动 UI 询问是否启用)
ANALYTICS_ENABLED=true
ANALYTICS_SENTRY_DSN=https://KEY@sentry.io/PROJECT
ANALYTICS_GA_TRACKING_ID=
ANALYTICS_MIXPANEL_TOKEN=
ANALYTICS_RETENTION_DAYS=30

# 存储 (本地文件系统)
STORAGE_STORAGE_TYPE=local_filesystem
STORAGE_ROOT_DIR=~/.dawei/files
STORAGE_CREATE_IF_MISSING=true

# SMTP (桌面不发邮件)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=


# =============================================================================
# 十四、Desktop 沙箱配置 (生产: docker/podman)
# =============================================================================

# ----- 14.1 Provider -----
# 2026-09-19 简化决策: PC App 版仅支持 Docker/Podman;
# e2b/cubesandbox/agentenv (云端硬件隔离) 与 subprocess 均被工厂守卫拒绝。

# Docker (Podman 兼容, 需用户本机已安装并运行)
DAWEI_SANDBOX_PROVIDER=docker
# auto = 自动检测 Docker/Podman, 不可用时显式报错 (不降级)
# DAWEI_SANDBOX_PROVIDER=auto

# ----- 14.2 workspace 白名单 -----

# 桌面用户的工作区通常在家目录下
DAWEI_WORKSPACE_ROOT_ALLOWLIST=/tmp:/home:/workspace:/srv:/data

# ----- 14.3 预热 -----

# 桌面懒加载
DAWEI_SANDBOX_PREWARM_ON_SESSION_START=0

# 工具执行模式: host (本地执行)
DAWEI_TOOL_EXECUTION_MODE=host


# =============================================================================
# 十五、WorkspaceStore 配置 (桌面: 本地后端 + 可选加密)
# =============================================================================

WORKSPACE_STORE_BACKEND=local
WORKSPACE_STORE_LOCAL_ROOT=~/.dawei/workspace-store

# 桌面加密密钥 (首次启动自动生成, 用户无需感知)
# WORKSPACE_STORE_ENCRYPTION_KEY=AUTO_GENERATED_ON_FIRST_LAUNCH

# 高级用户可选 S3 (自托管 RustFS 等):
# WORKSPACE_STORE_BACKEND=rustfs
# WORKSPACE_STORE_ENDPOINT=http://localhost:9000
# WORKSPACE_STORE_BUCKET=dawei-workspaces
# WORKSPACE_STORE_ACCESS_KEY=
# WORKSPACE_STORE_SECRET_KEY=
# WORKSPACE_STORE_REGION=us-east-1


# =============================================================================
# 十六、网络策略 (Desktop 不启用)
# =============================================================================

# eBPF 仅 SaaS 用
# DAWEI_SANDBOX_NETWORK_POLICY=


# =============================================================================
# 十七、Admin / Internal Token (桌面弱)
# =============================================================================

SANDBOX_ADMIN_TOKEN=local-prod-token
DAWEI_INTERNAL_TOKEN=local-prod-internal


# =============================================================================
# 十八、TUI / 运行时控制
# =============================================================================

DAWEI_TUI_MODE=false

# 超级模式 (永远 0, 桌面应用不允许用户开启)
DAWEI_SUPER_MODE=0

TEXTUAL_FULLSCREEN=1


# =============================================================================
# 十九、LiteLLM 兼容
# =============================================================================

LITELLM_API_KEY=