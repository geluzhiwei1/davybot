# =============================================================================
# Dawei Desktop 开发环境 — 环境变量配置示例
# =============================================================================
# 用法: cp .env.desktop.dev.example .env.desktop.dev && 编辑填入真实值
#       或者: ln -sf .env.desktop.dev.example .env
#
# 适用场景: 单用户桌面应用, 从源码运行 (uv run dev), DEBUG 日志,
#          本地 SQLite, subprocess 沙箱。
#
# 关键差异 (vs desktop.prod):
#   - ENVIRONMENT=development → 弱校验, secret 缺失仅警告
#   - LOG_LEVEL=DEBUG → 详细调试日志
#   - LOG_STRUCTURED_LOGGING=false → 人类可读格式
#   - LOG_ENABLE_TELEMETRY=false → 不上报
#   - ANALYTICS_ENABLED=false → 不上报数据
#   - AGENT_AUTO_APPROVE_TOOLS=true → 自动批准
#   - MEMORY_ENABLED=false → 默认关闭
#   - DAWEI_SUPER_MODE 可开 (用于调试)
#
# 桌面生产 (打包发行) 请使用 .env.desktop.prod.example
# =============================================================================


# =============================================================================
# 一、部署模式标识
# =============================================================================

# 运行模式: desktop (单用户本地; Tauri sidecar 启动时 CLI 也会注入此默认值)
DAWEI_RUNTIME_MODE=desktop

# 环境: development (弱校验, secret 缺失仅警告)
ENVIRONMENT=development


# =============================================================================
# 二、基础配置
# =============================================================================

# Dawei 主目录 (开发用家目录下)
DAWEI_HOME=~/.dawei

# Agent 主目录源代码根路径 (通常自动检测)
# DAWEI_AGENT_SRC_DIR=


# =============================================================================
# 三、日志配置 (LOG_ 前缀) — DEBUG 级别
# =============================================================================

LOG_LEVEL=DEBUG
LOG_CONSOLE_LEVEL=DEBUG
LOG_FILE_LEVEL=DEBUG
LOG_LOG_DIR=

LOG_MAX_FILE_SIZE=10
LOG_BACKUP_COUNT=5

# LLM API HTTP 日志 (开发开, 方便追踪 token 用量)
LOG_ENABLE_LLM_API_HTTP_LOGGING=true

# 性能日志
LOG_ENABLE_PERFORMANCE_LOGGING=true

# 遥测 (开发关)
LOG_ENABLE_TELEMETRY=false

# 结构化日志 (开发用人类可读)
LOG_STRUCTURED_LOGGING=false

# 敏感数据脱敏 (建议开启, 防止误提交 .env)
LOG_SANITIZE_SENSITIVE_DATA=true

AGENT_LOG_LEVEL=DEBUG


# =============================================================================
# 四、安全配置 (开发弱校验)
# =============================================================================

# JWT 签名密钥 (Desktop 弱校验, 可不设)
# 注: production 模式下会强制 32+ 字节
# JWT_SECRET=

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 数据加密密钥 (开发可空)
# ENCRYPTION_KEY=

# License 签名密钥 (开发可空)
# LICENSE_SECRET=

# PII 日志脱敏 salt (开发可不设, 用弱默认 + 警告)
# DAWEI_LOG_SALT=


# =============================================================================
# 五、数据库配置 (DB_ 前缀) — 本地 SQLite
# =============================================================================

DB_URL=sqlite:///~/.dawei/data/dawei.db

DB_PATH=~/.dawei/data/dawei.db

DB_ECHO=false

# SQLite 单连接
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0


# =============================================================================
# 六、Redis 配置 (REDIS_ 前缀) — Desktop 开发通常不用
# =============================================================================

# 单进程不需要 Redis, 仅启用 MCP / WebSocket 跨进程才需要
# REDIS_HOST=localhost
# REDIS_PORT=8024
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_MAX_CONNECTIONS=10


# =============================================================================
# 七、LLM 配置 (LLM_ 前缀)
# =============================================================================

LLM_DEFAULT_MODEL=deepseek-chat

# DeepSeek (国内直连, 推荐)
DEEPSEEK_API_KEY=sk-CHANGE_ME_DEV
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (本地离线 LLM, 桌面开发推荐)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=ollama

# Embedding (本地 Ollama)
LLM_EMBEDDING_BASE_URL=http://localhost:11434
LLM_EMBEDDING_API_KEY=ollama
LLM_EMBEDDING_MODEL=qwen3-embedding:8b

LLM_TIMEOUT=300
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0


# =============================================================================
# 八、Agent 配置 (AGENT_ 前缀)
# =============================================================================

AGENT_MODE=orchestrator
AGENT_ENABLE_AUTO_MODE_SWITCH=false

AGENT_ENABLE_SKILLS=true
AGENT_ENABLE_MCP=true

# 自动批准工具 (桌面用户自负责, 默认 true)
AGENT_AUTO_APPROVE_TOOLS=true

AGENT_MAX_CONCURRENT_SUBTASKS=3


# =============================================================================
# 九、Agent 重试 / 检查点 / 超时
# =============================================================================

AGENT_RETRY_MAX_RETRIES=3
AGENT_RETRY_RETRY_DELAY=1.0
AGENT_RETRY_RETRY_BACKOFF_FACTOR=2.0
AGENT_RETRY_MAX_DELAY=60.0

AGENT_CHECKPOINT_CHECKPOINT_INTERVAL=300
AGENT_CHECKPOINT_MAX_CHECKPOINTS=10
AGENT_CHECKPOINT_ENABLE_COMPRESSION=true

AGENT_TIMEOUT_TOOL_EXECUTION_TIMEOUT=60
AGENT_TIMEOUT_REQUEST_TIMEOUT=180


# =============================================================================
# 十、熔断器 / 限流器 / 请求队列
# =============================================================================

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=60.0
CIRCUIT_BREAKER_MAX_RETRIES=5

RATE_LIMITER_INITIAL_RATE=5.0
RATE_LIMITER_MIN_RATE=0.5
RATE_LIMITER_MAX_RATE=50.0
RATE_LIMITER_BURST_CAPACITY=20

REQUEST_QUEUE_MAX_CONCURRENT=5
REQUEST_QUEUE_MAX_QUEUE_SIZE=1000
REQUEST_QUEUE_DEFAULT_TIMEOUT=300.0


# =============================================================================
# 十一、外部服务 API 地址 (本地开发指向 localhost)
# =============================================================================

UNISEARCHER_API_URL=http://localhost:8014/api/v1/legal
SANCTIONS_API_URL=http://localhost:8012
SUPPORT_API_URL=http://localhost:8011/support/api
NORFLOW_API_URL=http://localhost:8013/api/v1
MARKET_API_URL=http://localhost:8011/support/api


# =============================================================================
# 十二、记忆 / 知识 / 技能 / 工具
# =============================================================================

# 记忆 (开发默认关)
MEMORY_ENABLED=false
MEMORY_DB_PATH=~/.dawei/memory.db
MEMORY_VIRTUAL_PAGE_SIZE=2000
MEMORY_MAX_ACTIVE_PAGES=5

SKILLS_ENABLED=true
SKILLS_AUTO_DISCOVERY=true

TOOL_BUILTIN_TOOLS_ENABLED=true
TOOL_SYSTEM_TOOLS_ENABLED=true
TOOL_USER_TOOLS_ENABLED=true
TOOL_WORKSPACE_TOOLS_ENABLED=true
TOOL_DEFAULT_TIMEOUT=60
TOOL_MAX_CONCURRENT_EXECUTIONS=3


# =============================================================================
# 十三、分析 / 存储 / 邮件
# =============================================================================

# 分析 (开发关闭, 不上报)
ANALYTICS_ENABLED=false
ANALYTICS_SENTRY_DSN=
ANALYTICS_GA_TRACKING_ID=
ANALYTICS_MIXPANEL_TOKEN=
ANALYTICS_RETENTION_DAYS=30

# 存储 (本地文件系统)
STORAGE_STORAGE_TYPE=local_filesystem
STORAGE_ROOT_DIR=~/.dawei/files
STORAGE_CREATE_IF_MISSING=true

# SMTP (Desktop 开发不配邮件)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=
# EMAIL_TO=


# =============================================================================
# 十四、Desktop 沙箱配置 (开发: docker/podman)
# =============================================================================

# ----- 14.1 Provider -----
# 2026-09-19 简化决策: PC App 版仅支持 Docker/Podman (subprocess 已移除);
# 开发机未安装 Docker/Podman 时, 沙箱命令将显式报错 (fail-fast)。

# Docker (Podman 兼容)
DAWEI_SANDBOX_PROVIDER=docker
# auto = 自动检测 Docker/Podman
# DAWEI_SANDBOX_PROVIDER=auto

# ----- 14.2 workspace 白名单 -----

DAWEI_WORKSPACE_ROOT_ALLOWLIST=/tmp:/home:/workspace:/srv:/data

# ----- 14.3 预热 -----

# 开发懒加载 (避免不必要的资源占用)
DAWEI_SANDBOX_PREWARM_ON_SESSION_START=0

# 工具执行模式: host (本地执行)
DAWEI_TOOL_EXECUTION_MODE=host


# =============================================================================
# 十五、WorkspaceStore 配置 (开发: 本地后端)
# =============================================================================

WORKSPACE_STORE_BACKEND=local
WORKSPACE_STORE_LOCAL_ROOT=~/.dawei/workspace-store

# 开发可不加密 (本地磁盘已有 FS 级加密)
# WORKSPACE_STORE_ENCRYPTION_KEY=

# 如需测试 S3 集成, 可临时切换:
# WORKSPACE_STORE_BACKEND=rustfs
# WORKSPACE_STORE_ENDPOINT=http://localhost:9000
# WORKSPACE_STORE_BUCKET=nn-bot-workspaces-dev
# WORKSPACE_STORE_ACCESS_KEY=rustfsadmin
# WORKSPACE_STORE_SECRET_KEY=rustfsadmin
# WORKSPACE_STORE_REGION=us-east-1


# =============================================================================
# 十六、网络策略 (Desktop 不启用)
# =============================================================================

# eBPF 仅 SaaS 用
# DAWEI_SANDBOX_NETWORK_POLICY=


# =============================================================================
# 十七、Admin / Internal Token (开发弱)
# =============================================================================

SANDBOX_ADMIN_TOKEN=local-dev-token
DAWEI_INTERNAL_TOKEN=local-dev-internal


# =============================================================================
# 十八、TUI / 运行时控制
# =============================================================================

DAWEI_TUI_MODE=false

# 超级模式 (开发可开, 用于调试边界场景)
# ⚠️ 严禁在生产开启
DAWEI_SUPER_MODE=0

TEXTUAL_FULLSCREEN=1


# =============================================================================
# 十九、LiteLLM 兼容 (开发可选)
# =============================================================================

LITELLM_API_KEY=