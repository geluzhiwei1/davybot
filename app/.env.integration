# Integration-test mode — point the frontend client at the LOCAL running dawei.
# Loaded only under `vitest --mode integration`. Overrides .env / .env.local.
# Required external-service VITE_* vars are inherited from .env (satisfies env.ts guard).
VITE_API_BASE_URL=http://localhost:8010
VITE_WS_BASE_URL=ws://localhost:8010
# Force the support LLM gateway to be unreachable so store.fetchModels exercises the
# best-effort degrade path deterministically (official=empty, local still shown, no logout),
# without depending on the production gateway.
VITE_SUPPORT_API_URL=http://127.0.0.1:39999
