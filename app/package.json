{
  "name": "nn-bot-app",
  "private": true,
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --mode server",
    "dev:web": "vite dev",
    "dev:desktop": "tauri dev",
    "build": "vite build",
    "build:web": "vite build",
    "build:desktop": "vite build --config vite.config.tauri.ts",
    "build:dev": "vite build --mode development",
    "build:server": "vite build --mode server",
    "build:full": "node scripts/assemble.mjs --mode production",
    "build:server:full": "node scripts/assemble.mjs --mode server",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:build": "cd ../engine/agent && uv run python scripts/build-binary.py",
    "sidecar:build:clean": "cd ../engine/agent && uv run python scripts/build-binary.py --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --mode integration --config vitest.config.integration.ts",
    "ci:lint": "node scripts/audit-lint.mjs",
    "ci:typecheck": "tsc --noEmit",
    "ci:build": "vite build",
    "audit:i18n": "node scripts/audit-i18n-parity.mjs",
    "audit:responsive": "node scripts/audit-responsive-parity.mjs",
    "audit:lint": "node scripts/audit-lint.mjs",
    "gen:research-types": "node scripts/gen-research-types.mjs",
    "ci:research-types": "node scripts/gen-research-types.mjs --check",
    "ci:test": "vitest run",
    "ci": "npm run ci:lint && npm run ci:typecheck && npm run ci:test && npm run ci:build && npm run ci:research-types && npm run audit:i18n && npm run audit:responsive",
    "package:linux": "tauri build --config src-tauri/tauri.conf.json --target x86_64-unknown-linux-gnu --bundles deb,appimage",
    "package:macos": "tauri build --config src-tauri/tauri.conf.json --target aarch64-apple-darwin --bundles dmg",
    "package:macos-x86_64": "tauri build --config src-tauri/tauri.conf.json --target x86_64-apple-darwin --bundles dmg",
    "package:windows": "tauri build --config src-tauri/tauri.conf.json --target x86_64-pc-windows-msvc --bundles nsis",
    "prepare": "husky",
    "build:mobile": "vite build --config vite.config.tauri.ts --mode mobile",
    "dev:mobile": "vite dev --config vite.config.tauri.ts --mode mobile"
  },
