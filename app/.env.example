# ===== davybot-app 环境变量模板（中性：无云端默认）=====
# 复制为 .env / .env.local / .env.<mode> 并按部署填写。
# F1 语义：业务服务 URL 全部可选 —— 留空 = 集成关闭（页面隐藏/调用降级），
# 引擎同源 API/WS 留空 = 相对路径（同源部署，如 server 内嵌 /app-ui）。

# nn-bot 引擎 API 地址（空 = 同源相对路径；Tauri 桌面填 http://localhost:8431）
VITE_API_BASE_URL=

# WebSocket 地址（空 = 运行时按页面 origin 推导 ws/wss）
VITE_WS_BASE_URL=

# WebSocket 重连配置
# VITE_WS_MAX_RECONNECT_ATTEMPTS: 0 = 无限重连（推荐），>0 = 最多重连 N 次后放弃
VITE_WS_MAX_RECONNECT_ATTEMPTS=0
# VITE_WS_RECONNECT_DELAY: 基础退避毫秒（指数退避，上限 30s）
VITE_WS_RECONNECT_DELAY=2000

# ── 可选业务集成（空 = 关闭）──
# Sanctions 知识库 API
VITE_SANCTIONS_API_URL=
# nn-kb-searcher API
VITE_KB_SEARCHER_API_URL=
# 用户系统 API
VITE_SUPPORT_API_URL=
# Market API（资源市场,nn-user-system）
VITE_MARKET_API_URL=
# Market Flow 市场智能控制面
VITE_MARKET_FLOW_API_URL=
# gelu-research-flow 科研控制面
VITE_RESEARCH_API_URL=
# social 控制面（空 = social 域禁用）
VITE_SOCIAL_API_URL=
# NormFlow 律所管理系统 API
VITE_NORFLOW_API_URL=
# 用户中心 Web 站点 base URL（外部浏览器打开；空 = 「我的账号」等入口不外跳）
VITE_USER_CENTER_BASE_URL=
