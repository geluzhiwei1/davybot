# ===== davybot-app Demo Mode — demo.normnomos.com (2026-09-21) =====
# Used by: DAVY_BIZ_ROOT=<davy-cloud>/biz npm run build:demo:full   # demo 部署唯一正确入口(组装+demo env)
#   - 裸 build:demo = 核心构建无 biz 域(sanctions 等页面缺失);
#   - 裸 build/build:full = 非 demo env,云端地址烤空 → 登录打到同源 /v1/auth/login → 404(0922 事故)。
# 语义与 .env.server 一致:引擎 API/WS 同源留空,业务服务直连云端。

# nn-bot 后端 API (same-origin, dawei :8431 behind edge nginx)
VITE_API_BASE_URL=
# WebSocket (same-origin)
VITE_WS_BASE_URL=
# 0 = 无限重连
VITE_WS_MAX_RECONNECT_ATTEMPTS=0
VITE_WS_RECONNECT_DELAY=2000

# Sanctions 知识库 API(直连云端)
VITE_SANCTIONS_API_URL=https://kb2.normnomos.com/sanctions
# nn-kb-searcher API(直连云端)
VITE_KB_SEARCHER_API_URL=https://kb2.normnomos.com/kb-searcher
# 用户系统 API(直连云端) — 登录/注册实际指向 {此值}/v1/auth/login
VITE_SUPPORT_API_URL=https://api.normnomos.com/support/api
# Market API(资源市场,直连云端)
VITE_MARKET_API_URL=https://api.normnomos.com/support/api
# Market Flow 市场智能控制面(直连云端)
VITE_MARKET_FLOW_API_URL=https://api.normnomos.com/marketflow
# gelu-research-flow 科研控制面(直连云端)
VITE_RESEARCH_API_URL=https://api.normnomos.com/researchflow
# social 控制面(直连云端;缺失会导致 social 域报"控制面未配置"整体禁用)
VITE_SOCIAL_API_URL=https://api.normnomos.com/socialflow
# NormFlow 律所管理系统 API(直连云端)
VITE_NORFLOW_API_URL=https://api.normnomos.com/nnflow

# 用户中心 Web 站点 base URL(外部浏览器打开)
VITE_USER_CENTER_BASE_URL=https://user.normnomos.com
